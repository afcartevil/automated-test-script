# jira-ops 运行时配置（复制为 .env 后填写；勿提交含密码的 .env）

# ----- Jira（必填；也可用 api_jira.py config set 自动同步） -----
JIRA_SERVER=http://jira.transsion.com/
JIRA_USERNAME=your.domain.account
JIRA_PASSWORD=your_password

# ----- 飞书文件分享（feishu.cn/file/...） -----
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- UNC 网络共享（JSON 数组，按 server 匹配凭据） -----
NETWORK_SERVERS=[{"server":"10.205.101.200","share":"fans_log","username":"monkeytest","password":"Monkey123"}]

# ----- 解压 .rar / .7z（可选，未设置则自动查找 PATH 或默认安装路径） -----
SEVEN_ZIP_EXE=C:\Program Files\7-Zip\7z.exe

# ----- Box 浏览器兜底（可选） -----
CHROME_BINARY=C:\Program Files\Google\Chrome\Application\chrome.exe

# ----- 默认工作区根（prepare-logs 未指定 --output-dir 时使用） -----
WORKSPACE_ROOT=./jira_workspace
