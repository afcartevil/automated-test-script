{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tdd-skills/modem-log-pipeline/job_manifest.schema.json",
  "title": "Modem Analysis Job Manifest",
  "description": "Phase 1 (modem-log-pipeline) → Phase 2 (modem-analysis-unified) 之间的契约。所有路径字段一律使用相对于 manifest 所在目录的相对路径（POSIX 风格，正斜杠）。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "issue_key",
    "schema_version",
    "jira",
    "final_log_root",
    "trace_exports",
    "_meta"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Manifest schema 版本号。",
      "const": "1.1.0"
    },
    "issue_key": {
      "type": "string",
      "minLength": 1,
      "description": "Jira 单号，如 OS162-37733。"
    },
    "final_log_root": {
      "type": "string",
      "description": "打包后日志根目录，相对于 manifest 所在目录。统一为 \"final_logs\"。",
      "const": "final_logs",
      "default": "final_logs"
    },
    "jira": {
      "type": "object",
      "description": "由 Phase 1 从 Jira 抓取的全部字段，Phase 2 不再访问 Jira。",
      "required": [
        "summary",
        "description",
        "comments_text",
        "urls_by_type",
        "url_roles",
        "affected_versions",
        "time_points",
        "platform",
        "chip_vendor",
        "chip_model",
        "sw_version"
      ],
      "properties": {
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "comments_text": { "type": "string" },
        "test_steps": {
          "type": "string",
          "description": "测试步骤（若 Jira 模板可解析则填充，否则为空字符串）。"
        },
        "expected_result": { "type": "string" },
        "actual_result": { "type": "string" },
        "time_window": {
          "type": "object",
          "description": "问题发生时间窗，由 time_points 推断或人工标注。",
          "properties": {
            "start": { "type": ["string", "null"] },
            "end": { "type": ["string", "null"] }
          }
        },
        "url_roles": {
          "type": "object",
          "description": "URL → DUT/REF 角色映射。"
        },
        "affected_versions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "urls_by_type": {
          "type": "object",
          "required": ["box", "feishu_file", "network_share", "http_direct"],
          "properties": {
            "box":           { "type": "array", "items": { "type": "string" } },
            "feishu_file":   { "type": "array", "items": { "type": "string" } },
            "network_share": { "type": "array", "items": { "type": "string" } },
            "http_direct":   { "type": "array", "items": { "type": "string" } }
          }
        },
        "time_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": { "type": "string" },
              "type":  { "type": "string" }
            }
          }
        },
        "platform": {
          "type": "string",
          "description": "平台代号，如 CN6/GEN99/GEN98。从 Jira 字段或日志推断。允许为空字符串，Phase 2 会标 gap。"
        },
        "chip_vendor": {
          "type": "string",
          "description": "芯片厂商，如 MTK/QCOM/UNISOC。允许为空字符串。"
        },
        "chip_model": {
          "type": "string",
          "description": "芯片型号。允许为空字符串。"
        },
        "sw_version": {
          "type": "string",
          "description": "软件版本。允许为空字符串。"
        }
      }
    },
    "downloads": {
      "type": "object",
      "description": "下载阶段输出（运行时元数据，Phase 2 不强依赖）。",
      "properties": {
        "download_root": { "type": "string" },
        "download_dirs": { "type": "array" },
        "results":       { "type": "array" }
      }
    },
    "extraction": {
      "type": "object",
      "description": "解压与过滤阶段输出（运行时元数据，Phase 2 不强依赖）。",
      "properties": {
        "normalized_log_roots": { "type": "array" },
        "extracted_dirs":       { "type": "array" },
        "filter_results":       { "type": "array" },
        "results":              { "type": "array" }
      }
    },
    "trace_exports": {
      "type": "object",
      "description": "Trace 导出与打包结果。aggregated_files / copied_support_files 至少需要其一非空（前者面向 NLT/ELT trace 类单，后者面向 AEE 等 dropbox 类单）。",
      "required": ["aggregated_files", "copied_support_files"],
      "properties": {
        "aggregated_files": {
          "type": "object",
          "description": "按分组（DUT/REF/...）→ 文件类型 → 相对路径的两级字典。AEE 等无 NLT/ELT trace 的单可以为空对象 {}。",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "copied_support_files": {
          "type": "object",
          "description": "辅助日志（radio_log/main_log/kernel_log/exp_main/pcap 等）→ 相对路径列表。",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "groups":           { "type": "array" },
        "results":          { "type": "array" }
      }
    },
    "pcap_export": {
      "type": "object",
      "description": "PCAP 导出阶段输出（可选）。"
    },
    "mddb": {
      "type": "object",
      "description": "MDDB / EDB 抓取结果（可选）。"
    },
    "analysis": {
      "type": "object",
      "description": "Phase 2 的运行时分析结果，Phase 1 不写入此字段，schema 不强约束其结构。"
    },
    "_meta": {
      "type": "object",
      "required": ["updated_at"],
      "properties": {
        "updated_at": {
          "type": "string",
          "description": "ISO-8601 时间戳。"
        },
        "phase1_completed_at": {
          "type": "string",
          "description": "Phase 1 完成时间戳，由 package_trace_outputs 落盘。"
        },
        "phase1_host": {
          "type": "string",
          "description": "Phase 1 执行机的主机名（便于排查跨机问题）。"
        },
        "phase1_smb_publish": {
          "type": "object",
          "description": "Phase 1 将 issue 目录发布到 Samba 的结果（仅记录元信息，Phase 2 不依赖）。",
          "properties": {
            "unc_base":     { "type": "string", "description": "目标 UNC 基础路径，如 \\\\10.205.4.20\\sw_temp\\通信开发部\\OS162-37733" },
            "published_at": { "type": "string" },
            "ok":           { "type": "boolean" },
            "mode":         { "type": "string", "description": "robocopy 模式，默认 /MIR" },
            "robocopy_exit": { "type": "integer", "description": "robocopy 退出码（0-7 视为成功）" },
            "message":      { "type": "string" },
            "host":         { "type": "string", "description": "执行发布的 Windows 主机名" },
            "jira_comment": {
              "type": "object",
              "description": "发布成功后可选追加的 Jira 评论结果（仅记录）",
              "properties": {
                "posted":    { "type": "boolean" },
                "skipped":   { "type": "boolean" },
                "reason":    { "type": "string" },
                "comment_id":{ "type": ["string", "null"] },
                "jira_server": { "type": "string" },
                "error":     { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
