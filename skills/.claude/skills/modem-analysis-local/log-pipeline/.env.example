# ============================================================
# modem-log-pipeline (Phase 1, Windows) 环境变量配置
# ============================================================

# ----- Jira 配置（fetch_issue_context.py / jira_post_publish_comment.py 用） -----
JIRA_SERVER=http://jira.transsion.com
JIRA_USERNAME=
JIRA_PASSWORD=
# 飞书看板「JIRA 链接」展示用（与 JIRA_SERVER API 地址分离）

# ----- 工作区根目录（本地盘，跑全流程实际读写的位置） -----
# 整体目录结构：{WORKSPACE_ROOT}/{issue_key}/job_manifest.json + final_logs/ + ...
# 推荐放在本地 SSD（D:/E: 盘），不要直接指向 UNC，否则解压/导出会很慢。
WORKSPACE_ROOT=D:\modem_pipeline_work

# ----- 浏览器（aliyun_pds_downloader.py 备用） -----
CHROME_BINARY=

# ----- 解压工具（recursive_extract.py 用） -----
# 例：C:\Program Files\7-Zip\7z.exe
SEVEN_ZIP_EXE=

# ----- Wireshark（pcap_to_txt.py 用） -----
# Windows 示例: C:\Program Files\Wireshark
# Linux 示例: /usr/bin
WIRESHARK_PATH=

# ----- ELT / NLT（export_traces.py 用） -----
ELT_HOME=
NLT_HOME=

# ----- QCOM / QUTS（export_traces.py 用，需安装 Qualcomm QUTS） -----
# QUTS_PYTHON_PATH：QUTS Support/python（供 export_modem_log 导入 QutsClient）
# 新版默认：C:\Program Files\Qualcomm\QUTS\Support\python
# 旧版：C:\Program Files (x86)\Qualcomm\QUTS\Support\python（升级后 x86\QUTS 通常只剩 Thrift）
# QUTS_PYTHON_PATH=
# QCOM_SKIP_EXPORT=1：不跑 QUTS，manifest 里只登记 .qmdl2/.qdss 路径（调试或机器未装 QUTS）
# QCOM_SKIP_EXPORT=0
# QCOM_KEEP_RAW_IN_PACKAGE=1：QUTS 已导出 txt 后，仍把原始 .qmdl2/.qdss 拷进 final zip（默认 0 只打 txt）
# QCOM_KEEP_RAW_IN_PACKAGE=0
# QCOM_EXPORT_MULTILINE=1：Diag 包按多行写出（默认单行，供 log-search-read 按行搜索）
# QCOM_EXPORT_MULTILINE=0
# 可选过滤（见 pipeline_steps/qcom/DESIGN.md）
# QCOM_EXPORT_TYPE=
# QCOM_EXPORT_ID=
# QCOM_EXPORT_SEARCH=
# QCOM_EXPORT_REGEX=0

# ----- 飞书（文件下载 + 分析看板 upsert） -----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 看板表：https://transsioner.feishu.cn/wiki/YaTFwxUIHiNdXFkget8cXiKTnXg?table=tblODuaS0CR9pzCW
# FEISHU_DASHBOARD_APP_TOKEN=YaTFwxUIHiNdXFkget8cXiKTnXg
# FEISHU_DASHBOARD_TABLE_ID=tblODuaS0CR9pzCW
# Step 10 写看板：1 开启（默认），0 跳过
# FEISHU_DASHBOARD_ENABLED=1
# 看板写入失败是否阻断 pipeline：默认 0（软失败）
# FEISHU_DASHBOARD_REQUIRED=0
#
# 看板列「日志导出状态」单选需与代码一致：未开始 / 成功 / 失败
# 另需列：日志导出失败步骤、导出错误摘要（列名须与 DashboardField 完全一致）

# ----- Gerrit（可选） -----
GERRIT_URL=https://gerrit.transsion.com
GERRIT_USERNAME=
GERRIT_PASSWORD=

# ----- 网络共享服务器（download_box_logs.py 解析 UNC 路径用） -----
NETWORK_SERVERS=[{"server":"10.205.101.200","share":"fans_log","username":"monkeytest","password":"Monkey123"},{"server":"10.150.152.37","share":"fans_log","username":"monkeytest","password":"Monkey123"},{"server":"10.150.152.38","share":"fans_log","username":"monkeytest","password":"Monkey123"},{"server":"10.150.152.39","share":"fans_log","username":"monkeytest","password":"Monkey123"}]

# ============================================================
# Samba 发布（Step 9 publish_to_samba.py 用）
# ============================================================
# Phase 1 完成后，将 {WORKSPACE_ROOT}\{issue_key}\ 打成 zip 上传到：
#   \\SMB_HOST\SMB_SHARE\{SMB_REMOTE_SUBPATH}\{YYYY-MM-DD}\{issue_key}.zip
# 例：通信开发部/AI2D-log/2026-05-22/OS162-37733.zip
# Phase 2 从 Jira 评论解析该相对路径后下载解压。

# 总开关：1=启用发布，0=跳过
SMB_PUBLISH_ENABLED=1
# 发布失败时整条 pipeline 是否算失败：1=是；0=仅告警，本地仍算成功
SMB_PUBLISH_REQUIRED=0

# 目标服务器与共享名（不含 \\ 前缀）
SMB_HOST=10.205.4.20
SMB_SHARE=sw_temp
# 共享下的子路径，可为空；支持中文，无需转义
SMB_REMOTE_SUBPATH=通信开发部/AI2D-log
# 可选：覆盖发布日期目录（默认当天 YYYY-MM-DD）
# SMB_PUBLISH_DATE=2026-05-22

# 凭据（仅写本地 .env，勿提交 git）
SMB_USERNAME=
SMB_PASSWORD=

# ----- 本地文件保留（下载、解压、过滤阶段不删源文件，便于继续分析调试） -----
# 默认保留。若需落盘后删 downloads/ 并执行 Step4 精简删文件，设：
#   PIPELINE_KEEP_LOCAL_FILES=0
# 或等价：DELETE_LOCAL_FILES_AFTER_PIPELINE=1
PIPELINE_KEEP_LOCAL_FILES=1
# 兼容旧变量（仅当未设 PIPELINE_KEEP_LOCAL_FILES 时 Step8 单独生效）：
# SKIP_DOWNLOAD_CLEANUP=1
# Step4 是否删非 modem/APLog 文件（默认跟随 PIPELINE_KEEP_LOCAL_FILES；可单独覆盖）：
# SKIP_LOG_FILTER_DELETION=1

# ----- Jira 持续扫描 / 自动导出 watcher（jira_export_watcher.py） -----
# 两条完整 JQL，脚本做差集：待处理 = JQL_ALL − JQL_EXPORTED（已导出 JQL 用正向 text ~，勿写 NOT text ~）
# JIRA_EXPORT_WATCHER_JQL_ALL=project in (LK7-tOS16) AND status in (Open, "In Progress", Reopened, Submitted, Fixed, Modifying) AND assignee in (liuyan.mo) AND created > "2026-05-01"
# JIRA_EXPORT_WATCHER_JQL_EXPORTED=project in (LK7-tOS16) AND status in (Open, "In Progress", Reopened, Submitted, Fixed, Modifying) AND assignee in (liuyan.mo) AND created > "2026-05-01" AND text ~ "modem-log-pipeline-export-flag"
# 兼容旧名：JIRA_EXPORT_WATCHER_JQL 等同 JQL_ALL
# JIRA_EXPORT_WATCHER_RUN_PIPELINE=1
# JIRA_EXPORT_WATCHER_PIPELINE_LOG_LEVEL=INFO
# JIRA_EXPORT_WATCHER_SLEEP_SECONDS=1800
# JIRA_EXPORT_WATCHER_PAGE_SIZE=50
# JIRA_EXPORT_WATCHER_LOG_LEVEL=INFO
# created 滚动窗口（自然日，含今天）：1=仅今天，7=近 7 天；避免无 URL 老单每轮进差集
# JIRA_EXPORT_WATCHER_CREATED_LOOKBACK_DAYS=1
# 固定 created 下界（设此项则忽略 LOOKBACK_DAYS）：JIRA_EXPORT_WATCHER_CREATED_SINCE=2026-05-01
# 影响版本过滤：仅处理 Affects Version/s 以以下前缀开头的单（逗号分隔，可多个）
# 示例：JIRA_EXPORT_WATCHER_AFFECTS_VERSION_PREFIXES=LK7-16,LK7-17
# JIRA_EXPORT_WATCHER_AFFECTS_VERSION_PREFIXES=
# watcher --platform qcom / sprd 时使用（MTK 测试机可不配）：
# JIRA_EXPORT_WATCHER_PREFIXES_QCOM=X6878-16
# JIRA_EXPORT_WATCHER_PREFIXES_SPRD=
# Jira 评论模板（watcher --platform 或 run_pipeline --platform 选用）：
# JIRA_PUBLISH_COMMENT_TEMPLATE_MTK=templates/jira_publish_comment.template.example
# JIRA_PUBLISH_COMMENT_TEMPLATE_QCOM=templates/jira_publish_comment.qcom.template.example
# JIRA_PUBLISH_COMMENT_TEMPLATE_SPRD=templates/jira_publish_comment.sprd.template.example
# 单号前缀约束（可选，逗号分隔；与上面的影响版本过滤叠加）
# 示例：JIRA_EXPORT_WATCHER_ISSUE_KEY_PREFIXES=LK7OS163-,LK7KOS17-
# JIRA_EXPORT_WATCHER_ISSUE_KEY_PREFIXES=
# 跳过无 log 的印度/俄罗斯粉丝反馈（summary 精确子串），不调用 run_pipeline.py
# JIRA_EXPORT_WATCHER_SKIP_FAN_NO_LOG=1

# ----- Samba 发布成功后，可选回写 Jira 评论（jira_post_publish_comment.py） -----
# 依赖 JIRA_SERVER、JIRA_USERNAME、JIRA_PASSWORD
# 模板路径：相对 modem-log-pipeline 工程根目录，或写绝对路径；UTF-8；语法见 templates/jira_publish_comment.template.example
JIRA_COMMENT_AFTER_PUBLISH=0
JIRA_PUBLISH_COMMENT_TEMPLATE=templates/jira_publish_comment.template.example
