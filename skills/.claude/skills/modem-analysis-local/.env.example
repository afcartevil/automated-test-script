# ============================================================
# modem-analysis-local — skill 根目录配置
# ============================================================
# 1. 复制为 .env：  copy .env.example .env
# 2. 同步给 pipeline： copy .env log-pipeline\.env
# 3. pip install -r requirements.txt

# ----- 工作区（必填，本地 SSD 路径） -----
# {WORKSPACE_ROOT}/{issue_key}/job_manifest.json + final_logs/ + ...
WORKSPACE_ROOT=D:\modem_workspace

# ----- Jira（log-pipeline Step 1） -----
JIRA_SERVER=http://jira.transsion.com
JIRA_USERNAME=
JIRA_PASSWORD=
JIRA_BROWSE_URL_BASE=http://jira.transsion.com

# ----- 解压 / 导出工具（日志准备） -----
SEVEN_ZIP_EXE=C:\Program Files\7-Zip\7z.exe
WIRESHARK_PATH=C:\Program Files\Wireshark
ELT_HOME=
NLT_HOME=
# QUTS_PYTHON_PATH=C:\Program Files\Qualcomm\QUTS\Support\python

# ----- 飞书（本地分析一般不用设置，可留空） -----
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_DASHBOARD_APP_TOKEN=
# FEISHU_DASHBOARD_TABLE_ID=

# ----- Gerrit（可选，fetch_mddb 等用；不用可留空） -----
GERRIT_URL=https://gerrit.transsion.com
GERRIT_USERNAME=
GERRIT_PASSWORD=

# ----- 网络共享（Jira 含 \\server\share 日志路径时配置；见 log-pipeline/.env.example） -----
# NETWORK_SERVERS=[{"server":"10.x.x.x","share":"fans_log","username":"","password":""}]

# ----- 日志准备：不发布网络共享（须同步到 log-pipeline\.env） -----
SMB_PUBLISH_ENABLED=0
