<!--
DRDI 配置示例文件
此文件展示了 DRDI 不同的配置方式及其在 .dws 文件中的典型格式
-->

<!-- 示例 1：ADC0 配置为 DRDI -->
<adc0>
    <varName>ADC_FDD_RF_PARAMS_DYNAMIC_CUSTOM_CH</varName>
</adc0>
<adc1>
    <varName></varName>
</adc1>
<adc2>
    <varName></varName>
</adc2>
<adc3>
    <varName></varName>
</adc3>
<adc4>
    <varName></varName>
</adc4>

