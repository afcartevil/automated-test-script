{
  "compilerOptions": {
    "target": "ES2024",
    "module": "commonjs",
    "rootDir": "src",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
