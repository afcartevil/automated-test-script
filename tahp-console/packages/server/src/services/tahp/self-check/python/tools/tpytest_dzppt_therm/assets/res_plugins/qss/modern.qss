

/* 公共样式 */
QMainWindow
{
	font-family: SimSun;
	background-color: #f2f4f7;
}
#EasyReadDialog
{
	background-color: #f2f4f7;
}


QPushButton {
    background-color: #a7d6ab; /* Green */
	border-radius: 30px;
	/*border:1px solid #999999;
	border-top: 5px solid qlineargradient(y0:0, y1:1,stop: 0 #ececef, stop: 1 white);
	border-left: 5px solid qlineargradient(x0:0, x1:1,stop: 0 #ececef, stop: 1 white);
	border-bottom: 5px solid qlineargradient(y0:0, y1:1,stop: 0 white, stop: 1  #ececef);
	border-right: 5px solid qlineargradient(x0:0, x1:1,stop:  0 white, stop: 1 #ececef);*/
    color: black;
    padding: 8px 18px;
    text-align: center;
    text-decoration: none;
    font-size: 14px;
}
QPushButton:disabled 
{
    background-color: #6C6C6D;
}


QPlainTextEdit:disabled
{
    background-color: white;
}
QListView:disabled
{
    background-color: white;
}
QPushButton:hover {
    background-color: #84ba7b;
}
#line_left
{
	border: none;
}
#line_right
{
	border: none;
}
/* 左部样式 */
#tree_devices
{
	border: none;
}
QTreeWidget:disabled 
{ 
	background-color: white; 
}

/* 中间样式 */
#widget
{
	/* 中间最顶部样式 */
	background-color: #FFFFFF;
	border-radius: 10px;
	border-top: 5px solid qlineargradient(y0:0, y1:1,stop: 0 #eff1f2, stop: 1 #f2f4f7);
	border-left: 5px solid qlineargradient(x0:0, x1:1,stop: 0 #eff1f2, stop: 1 #f2f4f7);
	border-bottom: 5px solid qlineargradient(y0:0, y1:1,stop: 0 #f2f4f7, stop: 1  #eff1f2);
	border-right: 5px solid qlineargradient(x0:0, x1:1,stop:  0 #f2f4f7, stop: 1 #eff1f2);
}
QTabWidget
{
	border: none;
}
QWidget::tab::selected
{
	width: 110px;
	height: 35px;
	font-size: 14px;
	font-weight: bold;
	border-bottom: 5px solid qlineargradient(y0:0, y1:1,stop: 0 #84ba7b, stop: 1  #84ba7b);
	font-family: 微软雅黑;
}
QWidget::tab:!selected
{
	width: 110px;
	height: 35px;
	font-size: 13px;
	border: none;
	font-weight: bold;
	font-family: 微软雅黑;
}
QWidget::tab:hover
{
	border-bottom: 5px solid qlineargradient(y0:0, y1:1,stop: 0 #dadadf, stop: 1  #dadadf);
	font-size: 14px;
}
