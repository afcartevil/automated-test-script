# TAHP Console 环境变量示例 — 复制为 .env 后按需修改

# === 基本 ===
PORT=8650
BIND_HOST=0.0.0.0
TAHP_CONSOLE_HOME=

# === 鉴权 ===
# 默认关闭鉴权 (内网团队工具)。开启 token 模式：设为 0 并查看 ~/.tahp-console/.token
AUTH_DISABLED=1
# AUTH_TOKEN=your-explicit-token

# === TAHP 项目根目录 ===
# 须为 git clone 根目录（含 tahp-console/、skills/、hermes-agent-main/）。
# 错误示例：盘符根 D:\ 或 E:\ 会导致 skills/jira-ops 等路径全部失效。
# 默认自动探测；多机部署建议显式设置：
# TAHP_PROJECT_ROOT=E:/TAHP/tahp

# Python 解释器（hermes-agent venv）。Windows 默认 python，Linux/macOS 默认 python3
# TAHP_PYTHON=python

# === 内置 hermes-agent-main（首次 npm run setup 或 dev 时自动写入）===
# HERMES_AGENT_ROOT=../hermes-agent-main
# HERMES_AGENT_BRIDGE_PYTHON=../hermes-agent-main/.venv/Scripts/python.exe
# HERMES_BIN=../hermes-agent-main/.venv/Scripts/hermes.exe
# TAHP_SKIP_AGENT_SETUP=1
# TAHP_SKIP_HERMES_SETUP_WIZARD=1

# === 中心同步（控制平面 / 执行平面分离）===
# 默认已指向内网官方中心（见 packages/server/src/config.ts），同事无需再配即可同步。
# 研发本机保持 local 角色；可用下方变量覆盖，或显式置空关闭中心接入：
#   - 新建知识条目 / 沉淀 / Skill 草稿 自动提交中心待审（本地不落权威库）
#   - 中心审核通过的内容定时 pull 到本地副本，供快速检索与离线使用
# TAHP_ROLE=local
# 本机联调中心：覆盖为 localhost
# TAHP_CENTRAL_URL=http://localhost:8660
# TAHP_CENTRAL_TOKEN=dev-shared-token-change-me
# 完全离线（不接中心）：取消注释并保持值为空
# TAHP_CENTRAL_URL=
# TAHP_CENTRAL_TOKEN=
# 增量 pull 间隔（毫秒），默认 300000（5 分钟）；<=0 关闭定时
# TAHP_SYNC_INTERVAL_MS=300000

# === 验测任务自动执行（仅测试账号：域账号 test- 前缀）===
# 默认开启：收到中心指派的验测任务后，自动等设备 → 刷最新 daily（含 Root 包）→ 启动测试项 →
# 打标签（等待设备 / 验测执行中 / 等待人工确认 …）→ 报告落盘后自动关单并关联 run_id。
# 例外：「转测摸底测试 / 周版本测试」不自动执行，仅在「总览 → 验测任务」展示（待人工执行）；
# 「GMS测试」自动执行但不刷机、不刷 Root 包，直接使用设备当前版本。
# 人工确认用例不自动应答；EA「质量验测 → 总览」卡片可暂停/取消。
# TAHP_VERIFY_AUTO_RUN_DISABLED=1     # 整体关闭自动执行
# TAHP_VERIFY_AUTO_RUN_POLL_MS=30000  # 轮询间隔（等设备 / 推进相位 / 关单重试）
# TAHP_VERIFY_AUTO_RUN_WAIT_MS=14400000  # 单个任务等设备上限，默认 4 小时，超时打「等待设备超时」
# TAHP_VERIFY_AUTO_RUN_DIR=           # 状态目录，默认 {工程根}/.tahp-config/verify-auto-run

# === 底软通信 Dify 外部知识库（模式 A：本地先答 + 异步补充）===
# 默认启用（DPAPI 零配置引导 Key）；对话 UI 默认开、可关。
# TAHP_DIFY_SEARCH_ENABLED=0
# TAHP_DIFY_API_BASE=https://dify-service-hk.transsion.com/v1
# TAHP_DIFY_API_KEY=app-your-key-here
# TAHP_DIFY_TIMEOUT_MS=45000
# TAHP_DIFY_FALLBACK_LOCAL=1

# === 日志 ===
LOG_LEVEL=info

# === 大模型 API 配置 ===
#
# TAHP 对话支持三种接入模式（三选一）：
#
# 【模式 A - 推荐】在"模型管理"页面配置 API Key（写入 profile .env，无需改此文件）
#   → 打开控制台 → 系统 → 模型管理 → 添加 Anthropic/OpenAI 提供商 → 填入 Key
#   服务器自动从 profile .env 读取，无需重启。
#
# 【模式 B】在此文件配置（服务器启动时读取，修改后需重启）
# ANTHROPIC_API_KEY=sk-ant-api03-your-real-key-here
# OPENAI_API_KEY=sk-proj-your-real-key-here
#
# 【模式 C】自定义上游代理（兼容 OpenAI Responses API /v1/responses 格式）
# TAHP_LLM_UPSTREAM=http://your-internal-proxy:8080
# TAHP_API_KEY=your-proxy-key
