# 模块约束配置模板
# ══════════════════════════════════════════════════════════════
# 用途: 新模块初始化时的基本信息模板
# 使用方法: python scripts/init_module.py --name <module-name>
#
# 本文件是每个模块的入口文件，定义模块的身份、归属、边界和域覆盖范围。
# 填写完成后，系统会根据此文件自动初始化对应域的约束文件。
#
# 参考文档: TAHP-约束文件编写规范.md §3
# ══════════════════════════════════════════════════════════════

module:
  name: "{{ module_name }}"
  display_name: "{{ display_name }}"
  domain: "{{ domain }}"
  version: "1.0.0"
  description: "{{ description }}"
  scope: |
    {{ scope }}
  owner: "{{ owner }}"
  team: "{{ team }}"
  created_at: "{{ created_at }}"
  updated_at: "{{ updated_at }}"

# ===== 模块边界（必填） =====
scope:
  # 包含的子系统/组件
  includes:
    - component: "{{ component_1_name }}"
      path: "{{ component_1_path }}"
      description: "{{ component_1_description }}"
    - component: "{{ component_2_name }}"
      path: "{{ component_2_path }}"
      description: "{{ component_2_description }}"

  # 明确排除的区域
  excludes:
    - "{{ exclude_path_1 }}"
    - "{{ exclude_path_2 }}"

  # 与其他模块的依赖关系
  dependencies:
    - module: "{{ dep_module_1 }}"
      type: "{{ dep_type_1 }}"
      description: "{{ dep_description_1 }}"

# ===== 依赖声明 =====
dependencies:
  modules: []
  platforms: []

# ===== 覆盖的约束域 =====
# 根据模块实际业务需求，取消注释相应的域
domains:
  - bug-analysis
  {% if has_code_adaptation %}- code-adaptation{% endif %}
  {% if has_version_adaptation %}- version-adaptation{% endif %}
  {% if has_carrier_porting %}- carrier-porting{% endif %}

# ===== 安全红线（所有操作必须遵守） =====
safety_redlines:
  - "禁止修改安全关键代码（SEAndroid策略、Trustzone接口）"
  - "禁止绕过或禁用安全验证机制"
  - "所有对外接口变更需经过安全评审"
  - "不修改 scope.excludes 中列出的任何文件"
  - "不在未验证API存在性的情况下生成代码"
  - "不硬编码密钥/Token/设备标识"
  - "涉及安全相关的Bug必须标记为Critical"
  - "所有代码修改必须在编译门禁中通过"
