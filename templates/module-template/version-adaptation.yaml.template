# 版本适配域约束模板
# 使用方法: 由 init_module.py 从本模板生成实际约束文件
# 对应域: version_adaptation (适配引擎)

version_info:
  source:
    android_version: "{{ source_android_version | default('14') }}"
    code_name: "{{ source_code_name | default('UpsideDownCake') }}"
    api_level: "{{ source_api_level | default('34') }}"
  target:
    android_version: "{{ target_android_version | default('15') }}"
    code_name: "{{ target_code_name | default('VanillaIceCream') }}"
    api_level: "{{ target_api_level | default('35') }}"

migration_rules:
  api_changes:
    # 框架层API变更
    framework:
      - rule_id: "FWK-{{ module_prefix | upper }}-001"
        type: "deprecated"
        source_api: "{{ source_api_example | default('') }}"
        target_api: "{{ target_api_example | default('') }}"
        migration: "{{ migration_description | default('请参考shared/api-migration-rules/') }}"
        impact: "{{ impact_level | default('medium') }}"

    # HAL层API变更
    hal:
      - rule_id: "HAL-{{ module_prefix | upper }}-001"
        type: "{{ hal_change_type | default('interface_changed') }}"
        description: "{{ hal_change_description | default('HAL接口变更，请查阅AOSP diff') }}"
        migration: "{{ hal_migration_guide | default('参考hardware/interfaces/变更日志') }}"
        impact: "{{ hal_impact_level | default('high') }}"

  config_changes:
    - description: "系统属性变更"
      check: "diff build/target/product/*.prop"
      action: "更新系统属性配置，确保新版本属性值正确"
    - description: "SELinux策略变更"
      check: "diff system/sepolicy/"
      action: "更新sepolicy规则，确保新版本策略兼容"
    - description: "编译配置变更"
      check: "diff build/soong/ build/make/"
      action: "更新编译配置，处理Soong/Bp迁移"

compatibility_matrix:
  must_verify:
    - "所有scope.includes中的路径在新版本中仍存在"
    - "依赖的API在新版本中未被移除（或已有替代方案）"
    - "编译配置与目标版本编译系统兼容"
    - "SELinux策略与目标版本策略框架兼容"
  skip_if_same:
    - "如果模块代码无直接平台API依赖"
    - "如果目标版本仅是小版本更新（API level不变）"

testing_requirements:
  smoke_test:
    - "{{ smoke_test_1 | default('模块核心功能冒烟测试') }}"
    - "{{ smoke_test_2 | default('回归测试用例集') }}"
  full_test:
    - "{{ full_test_1 | default('完整的模块自动化测试') }}"
  manual_test:
    - "{{ manual_test_1 | default('关键用户场景手动验证') }}"

rollback_criteria:
  - "编译失败（零error要求）"
  - "核心功能回归测试通过率低于95%"
  - "引入新的安全红线违反"
  - "关键API适配不完整且无workaround"
  - "性能下降超过10%"

safety_redlines:
  - "不修改安全相关配置（SEAndroid、Trustzone、Keystore）"
  - "不降级安全策略或权限检查"
  - "不在未验证的情况下假设API行为不变"
  - "所有迁移规则必须引用 shared/api-migration-rules/ 中已验证的规则"
