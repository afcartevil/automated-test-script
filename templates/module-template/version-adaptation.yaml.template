# =============================================================================
# Version Adaptation Constraint Template
# =============================================================================
# Domain: version_adaptation (Adaptation Engine)
# Module: {{module_name}}
#
# This constraint file governs how the AI agent performs Android version
# upgrade migration for the specified module. It defines migration rules,
# API change handling, testing requirements, and rollback procedures.
#
# Usage:
#   1. Copy to: constraints/<module_name>/version_adaptation.yaml
#   2. Replace all {{placeholder}} values
#   3. Add version-specific migration entries in migration_rules.api_changes
#   4. Configure rollback_criteria based on module risk profile
# =============================================================================

metadata:
  module: "{{module_name}}"
  domain: "version_adaptation"
  version: "1.0.0"
  author: "{{author}}"
  last_updated: "{{date}}"
  description: "Version adaptation constraints for {{module_name}} - migrating from {{source_android_version}} to {{target_android_version}}"

# ---------------------------------------------------------------------------
# Version Information
# ---------------------------------------------------------------------------
version_info:
  source:
    android_version: "{{source_android_version}}"  # e.g., "14"
    api_level: "{{source_api_level}}"              # e.g., "34"
    codename: "{{source_codename}}"                # e.g., "UpsideDownCake"
    build_fingerprint: "{{source_build_fingerprint}}"

  target:
    android_version: "{{target_android_version}}"  # e.g., "15"
    api_level: "{{target_api_level}}"              # e.g., "35"
    codename: "{{target_codename}}"                # e.g., "VanillaIceCream"
    build_fingerprint: "{{target_build_fingerprint}}"

  migration_type: "upgrade"  # Options: upgrade, downgrade, sideload

# ---------------------------------------------------------------------------
# Migration Rules: How to handle API and behavioral changes
# ---------------------------------------------------------------------------
migration_rules:
  # Deprecated APIs that must be replaced
  deprecated_apis:
    - old_api: "{{deprecated_api_1}}"  # e.g., "TelephonyManager.getDataNetworkType()"
      replacement: "{{replacement_api_1}}"  # e.g., "TelephonyManager.getDataNetworkType(subId)"
      migration_note: "{{migration_note_1}}"  # e.g., "Requires subscription ID parameter"
      severity: "P0"  # Must fix - API removed in target version
      auto_migrate: true  # AI can automatically apply this migration

    - old_api: "{{deprecated_api_2}}"
      replacement: "{{replacement_api_2}}"
      migration_note: "{{migration_note_2}}"
      severity: "P1"  # Should fix - API deprecated but still functional
      auto_migrate: true

  # New APIs that should be adopted (optional improvements)
  new_apis:
    - api: "{{new_api_1}}"  # e.g., "TelephonyManager.isEmergencyNumber(number)"
      benefit: "{{new_api_benefit_1}}"  # e.g., "More reliable emergency number detection"
      adoption_priority: "P2"  # Optional - consider adopting
      auto_adopt: false  # Requires human decision

  # Behavioral changes that don't involve API changes but affect behavior
  behavioral_changes:
    - area: "{{behavioral_area_1}}"  # e.g., "background_service_restrictions"
      old_behavior: "{{old_behavior_description}}"
      new_behavior: "{{new_behavior_description}}"
      impact: "{{impact_description}}"  # e.g., "May cause service to be killed in background"
      mitigation: "{{mitigation_strategy}}"
      severity: "P1"

    - area: "{{behavioral_area_2}}"
      old_behavior: "{{old_behavior_description}}"
      new_behavior: "{{new_behavior_description}}"
      impact: "{{impact_description}}"
      mitigation: "{{mitigation_strategy}}"
      severity: "P2"

  # Framework signature changes (method signatures, class hierarchies)
  signature_changes:
    - class: "{{changed_class_1}}"  # e.g., "android.telephony.TelephonyManager"
      method: "{{changed_method_1}}"
      old_signature: "{{old_method_signature}}"
      new_signature: "{{new_method_signature}}"
      migration: "{{signature_migration_note}}"

  # Permission changes between versions
  permission_changes:
    - permission: "{{permission_1}}"  # e.g., "android.permission.READ_PHONE_STATE"
      old_level: "{{old_permission_level}}"  # e.g., "normal"
      new_level: "{{new_permission_level}}"  # e.g., "dangerous"
      action_required: "{{permission_action}}"  # e.g., "Request at runtime"
      severity: "P0"

  # Build system changes
  build_changes:
    - area: "{{build_area_1}}"  # e.g., "SDK version"
      old_value: "{{old_build_value}}"  # e.g., "34"
      new_value: "{{new_build_value}}"  # e.g., "35"
      file: "{{build_file}}"  # e.g., "build.gradle"
      severity: "P0"

    - area: "java_version"
      old_value: "{{old_java_version}}"  # e.g., "17"
      new_value: "{{new_java_version}}"  # e.g., "21"
      file: "{{build_file}}"
      severity: "P0"

  # Example migration entries (reference implementations)
  examples:
    - title: "Migrate TelephonyManager API call with subscription ID"
      source_code: |
        // Android {{source_android_version}}
        int networkType = tm.getDataNetworkType();
      target_code: |
        // Android {{target_android_version}}
        int networkType = tm.getDataNetworkType(getDefaultSubscriptionId());
      notes: "Added subscription ID parameter required in Android {{target_android_version}}"

    - title: "Update SDK version in build configuration"
      source_code: |
        compileSdkVersion {{source_api_level}}
        targetSdkVersion {{source_api_level}}
      target_code: |
        compileSdkVersion {{target_api_level}}
        targetSdkVersion {{target_api_level}}
      notes: "Updated SDK versions to match Android {{target_android_version}}"

# ---------------------------------------------------------------------------
# Migration Scope: Files and directories involved in the migration
# ---------------------------------------------------------------------------
migration_scope:
  # Directories to scan for deprecated API usage
  scan_paths:
    - "{{source_path}}"  # Module source code
    - "{{test_path}}"    # Module test code (if applicable)

  # File patterns to include in the migration scan
  include_patterns:
    - "**/*.java"
    - "**/*.kt"
    - "**/*.aidl"
    - "**/Android.bp"
    - "**/Android.mk"
    - "**/build.gradle"

  # File patterns to exclude from the migration scan
  exclude_patterns:
    - "**/R.java"
    - "**/BuildConfig.java"
    - "**/.git/**"
    - "{{excluded_path_1}}"  # e.g., "vendor/**"

# ---------------------------------------------------------------------------
# Testing Requirements
# ---------------------------------------------------------------------------
testing_requirements:
  pre_migration:
    - type: "unit_tests"
      command: "{{pre_migration_test_command}}"
      description: "Run unit tests on source version to establish baseline"
      required: true
      save_results: true  # Save for post-migration comparison

    - type: "compilation_check"
      command: "{{pre_migration_build_command}}"
      description: "Verify source version compiles successfully"
      required: true

  post_migration:
    - type: "compilation_check"
      command: "{{post_migration_build_command}}"
      description: "Verify target version compiles after migration"
      required: true

    - type: "unit_tests"
      command: "{{post_migration_test_command}}"
      description: "Run unit tests on migrated code"
      required: true
      baseline_comparison: true

    - type: "integration_tests"
      command: "{{integration_test_command}}"
      description: "Run integration tests for affected subsystems"
      required: false

    - type: "cts_tests"
      command: "{{cts_test_command}}"  # e.g., "run cts -m CtsTelephonyTestCases"
      description: "Run relevant CTS test modules"
      required: false

# ---------------------------------------------------------------------------
# Rollback Criteria: When to abort migration and revert
# ---------------------------------------------------------------------------
rollback_criteria:
  # Automatic rollback triggers (no human confirmation needed)
  automatic_rollback:
    - condition: "compilation_failure"
      description: "Target version fails to compile after migration"
      severity: "P0"

    - condition: "critical_test_failure"
      description: "More than {{critical_test_failure_threshold}}% of critical tests fail"
      threshold: "{{critical_test_failure_threshold}}"  # e.g., "10"
      severity: "P0"

    - condition: "safety_red_line_violation"
      description: "Migration introduces a safety red line violation"
      severity: "P0"

  # Manual review triggers (require human decision)
  manual_review:
    - condition: "behavioral_change_detected"
      description: "Unexpected behavioral change detected during testing"
      severity: "P1"

    - condition: "significant_test_regression"
      description: "Test pass rate drops by more than {{regression_threshold}}%"
      threshold: "{{regression_threshold}}"  # e.g., "5"
      severity: "P1"

    - condition: "incomplete_migration"
      description: "Not all deprecated APIs could be automatically migrated"
      severity: "P1"

  # Rollback procedure
  rollback_procedure:
    steps:
      - "Create a git tag at the pre-migration commit: git tag pre-migration-{{module_name}}-{{date}}"
      - "Run: git checkout pre-migration-{{module_name}}-{{date}}"
      - "Verify source version compiles and tests pass"
      - "Report rollback reason and migration blockers"
    git_required: true

# ---------------------------------------------------------------------------
# Safety Red Lines: Non-negotiable boundaries for version adaptation
# ---------------------------------------------------------------------------
safety_red_lines:
  - id: "no_api_removal_without_replacement"
    description: "Never remove a deprecated API call without providing its replacement"
    severity: "P0"
    check: "Every removed API call must have a corresponding replacement in the diff"

  - id: "no_permission_escalation"
    description: "Never introduce new permissions without explicit documentation"
    severity: "P0"
    check: "New permission additions must be listed in migration report"

  - id: "no_behavioral_regression"
    description: "Never accept migration that introduces known behavioral regressions"
    severity: "P0"
    check: "All behavioral_change items with severity P0 must have mitigations applied"

  - id: "preserve_backward_compatibility"
    description: "Maintain backward compatibility where possible during migration"
    severity: "P1"
    check: "Use @Deprecated annotations and fallback methods for transitional support"

  - id: "no_unreviewed_new_api"
    description: "Do not adopt new APIs without reviewing their stability and requirements"
    severity: "P2"
    check: "New API adoptions must have documented rationale"

# ---------------------------------------------------------------------------
# Evaluation Criteria
# ---------------------------------------------------------------------------
evaluation_criteria:
  accuracy:
    - metric: "api_migration_complete"
      weight: 0.35
      description: "All deprecated P0/P1 APIs successfully migrated"
      threshold: 0.95

    - metric: "build_compilation"
      weight: 0.2
      description: "Migrated code compiles on target version"
      threshold: 1.0

    - metric: "permission_migration"
      weight: 0.1
      description: "All permission changes correctly applied"
      threshold: 0.9

  completeness:
    - metric: "file_coverage"
      weight: 0.15
      description: "All files in migration scope have been processed"
      threshold: 0.95

    - metric: "behavioral_mitigation"
      weight: 0.1
      description: "All P0/P1 behavioral changes have mitigations applied"
      threshold: 0.8

    - metric: "build_config_updated"
      weight: 0.1
      description: "Build configuration updated to target version"
      threshold: 1.0

  safety:
    - metric: "red_line_compliance"
      weight: 1.0
      description: "Zero safety red line violations"
      threshold: 1.0

# ---------------------------------------------------------------------------
# Tool Access Configuration
# ---------------------------------------------------------------------------
tool_access:
  file_read: true
  file_write: true
  code_search: true
  log_parse: true
  git_ops: "full"
  build_run: true
  report_gen: true
