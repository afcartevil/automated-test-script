# 代码适配域约束模板
# 使用方法: 由 init_module.py 从本模板生成实际约束文件
# 对应域: code_adaptation (诊断引擎)

build_rules:
  compile_commands:
    - "make {{ build_target | default('target') }} -j$(nproc)"
  checkpatch:
    enabled: {{ checkpatch_enabled | default(true) | lower }}
    extra_args: "--no-tree --max-line-length=100"
  kconfig:
    enabled: {{ kconfig_enabled | default(false) | lower }}

modification_rules:
  allowed_patterns:
    - description: "修复指定Bug相关代码"
      condition: "有明确Bug ID和影响范围"
      max_files: 20
      max_lines_per_file: 200
    - description: "适配新API替代废弃API"
      condition: "有明确的API迁移记录"
      requires_review: true

  forbidden_patterns:
    - "删除或注释掉现有安全检查"
    - "降低现有权限检查级别"
    - "移除错误处理逻辑"
    - "硬编码配置值（应使用配置文件或系统属性）"
    - "使用 @SuppressWarnings / @SuppressLint 抑制错误"
    - "复制粘贴大段代码（>50行），应提取为公共方法"

  naming_conventions:
    variables: "{{ naming_var | default('camelCase') }}"
    functions: "{{ naming_func | default('camelCase') }}"
    constants: "{{ naming_const | default('UPPER_SNAKE_CASE') }}"
    classes: "{{ naming_class | default('PascalCase') }}"

quality_gates:
  P0_block:
    - "编译通过（零error）"
    - "scope.excludes 中的文件未被修改"
    - "安全红线未被违反"
    - "API调用在目标版本中存在"
  P1_warning:
    - "编码风格符合项目规范"
    - "无Lint warning新增"
    - "废弃API已标记并记录迁移计划"
    - "TODO注释关联对应JIRA/Bug ID"
  P2_record:
    - "代码圈复杂度不超过15"
    - "代码重复率不超过5%"
    - "关键方法有注释说明"

output_format:
  patch_style: "unified diff"
  commit_message: |
    [{{ module_name }}] {{ bug_id | default('BUGFIX') }}: {{ brief_description }}

    详细描述:
    - 根因: {{ root_cause_summary }}
    - 修改: {{ change_summary }}
    - 验证: {{ verification_summary }}

    Change-Id: {{ gerrit_change_id | default('') }}

rollback_strategy:
  method: "git revert"
  criteria: "如果修改后回归测试失败或引入新的P0问题，立即revert"
  timeout: "代码合并后48小时内"
