# =============================================================================
# Code Adaptation Constraint Template
# =============================================================================
# Domain: code_adaptation (Adaptation Engine)
# Module: {{module_name}}
#
# This constraint file governs how the AI agent performs code adaptation tasks
# such as coding style enforcement, standard compliance, and quality adaptation
# for the specified module.
#
# Usage:
#   1. Copy to: constraints/<module_name>/code_adaptation.yaml
#   2. Replace all {{placeholder}} values
#   3. Customize rules for module-specific coding standards
#   4. Review safety_red_lines before enabling write access
# =============================================================================

metadata:
  module: "{{module_name}}"
  domain: "code_adaptation"
  version: "1.0.0"
  author: "{{author}}"
  last_updated: "{{date}}"
  description: "Code adaptation constraints for {{module_name}} module"

# ---------------------------------------------------------------------------
# Compilation Rules: Code style and compilation standards
# These rules are applied when the AI generates or modifies code.
# ---------------------------------------------------------------------------
compilation_rules:
  # Android checkpatch rules (for Java/Kotlin code)
  checkpatch:
    enabled: true
    severity: "P1"
    rules:
      - id: "line_length"
        max_length: 100
        description: "Lines must not exceed 100 characters"
      - id: "indentation"
        style: "spaces"
        size: 4
        description: "Use 4-space indentation (no tabs)"
      - id: "braces"
        style: "k_r"  # K&R style braces
        description: "Opening brace on same line as control statement"
      - id: "naming_conventions"
        classes: "PascalCase"
        methods: "camelCase"
        constants: "UPPER_SNAKE_CASE"
        variables: "camelCase"
        description: "Follow Android Java/Kotlin naming conventions"

  # Kernel coding style rules (for kernel/driver modules)
  kernel_coding_style:
    enabled: false  # Set to true for kernel modules
    severity: "P1"
    rules:
      - id: "linux_indent"
        description: "Use Linux kernel coding style (tabs, 8-char indent)"
        check_command: "scripts/checkpatch.pl --no-tree"
      - id: "kconfig_rules"
        description: "Follow Kconfig naming: CONFIG_ prefix, lowercase, underscores"
      - id: "includes_order"
        description: "Include order: linux/, asm/, module headers, local headers"
      - id: "no_static_inline_in_header"
        description: "Avoid static inline functions in header files"

  # Build verification
  build_verification:
    enabled: true
    steps:
      - "Incremental build after modification"
      - "Full build for header/interface changes"
      - "Check for new compiler warnings (treat -Werror violations as P1)"

# ---------------------------------------------------------------------------
# Modification Rules: What the AI can and cannot modify
# These rules define the boundaries of code adaptation operations.
# ---------------------------------------------------------------------------
modification_rules:
  # Files and directories the AI is allowed to modify
  allowed_modifications:
    - path: "{{source_path}}"  # Module source directory
      description: "Module source code within defined scope"
    - path: "{{test_path}}"  # Module test directory
      description: "Module test code"
    - path: "{{config_path}}"  # Module configuration
      description: "Module configuration files"

  # Patterns that are explicitly forbidden from modification
  forbidden_modifications:
    - pattern: "{{certified_file_pattern}}"  # e.g., "vendor/**/certified/**"
      reason: "Carrier-certified files must not be modified without approval"
      severity: "P0"
    - pattern: "{{security_file_pattern}}"  # e.g., "**/sepolicy/**"
      reason: "Security policy files require dedicated review"
      severity: "P0"
    - pattern: "**/OWNERS"
      reason: "Code ownership files must not be modified by AI"
      severity: "P0"

  # Modification patterns that require additional approval
  approval_required:
    - pattern: "{{interface_pattern}}"  # e.g., "*/aidl/**/*.aidl"
      reason: "Interface changes may affect other modules"
      approver: "{{interface_reviewer}}"  # e.g., "platform-team"
      severity: "P1"
    - pattern: "{{manifest_pattern}}"  # e.g., "**/AndroidManifest.xml"
      reason: "Manifest changes affect app permissions and components"
      approver: "{{manifest_reviewer}}"
      severity: "P1"

  # Types of modifications allowed
  allowed_operations:
    - "refactor_variable_naming"
    - "add_null_checks"
    - "fix_code_style"
    - "update_deprecated_api"
    - "add_error_handling"
    - "update_comments_and_docs"

  # Types of modifications NOT allowed
  forbidden_operations:
    - "remove_error_handling"
    - "remove_logging"
    - "disable_safety_checks"
    - "remove_synchronization"
    - "change_public_api_signatures"

# ---------------------------------------------------------------------------
# Quality Gates: Multi-level quality validation
# Each modification must pass through these gates before being accepted.
# ---------------------------------------------------------------------------
quality_gates:
  P0_critical:
    description: "Critical checks - failure blocks the output completely"
    checks:
      - id: "compilation_success"
        description: "Code must compile without errors"
        tool: "build_run"
      - id: "no_new_compiler_warnings"
        description: "No new warnings introduced (if -Werror is enabled)"
        tool: "build_run"
      - id: "safety_red_lines_passed"
        description: "All safety red line checks passed"
        tool: "automated"
      - id: "no_forbidden_modifications"
        description: "No files in forbidden_modifications were changed"
        tool: "automated"
    threshold: 100  # All checks must pass
    action: "BLOCK - Reject output and report failure"

  P1_important:
    description: "Important checks - failure requires human review"
    checks:
      - id: "checkpatch_compliance"
        description: "Code passes checkpatch with no errors"
        tool: "build_run"
      - id: "tests_pass"
        description: "Existing unit tests still pass"
        tool: "build_run"
      - id: "no_behavioral_change"
        description: "Modification does not change functional behavior"
        tool: "automated"
      - id: "imports_clean"
        description: "No unused imports added"
        tool: "automated"
    threshold: 80  # 80% of checks must pass
    action: "WARN - Flag for human review before acceptance"

  P2_standard:
    description: "Standard checks - informational, logged but not blocking"
    checks:
      - id: "documentation_updated"
        description: "Code comments updated to reflect changes"
        tool: "automated"
      - id: "consistent_style"
        description: "Changes match surrounding code style"
        tool: "automated"
      - id: "no_trailing_whitespace"
        description: "No trailing whitespace added"
        tool: "automated"
      - id: "meaningful_commit_message"
        description: "Commit message follows project conventions"
        tool: "automated"
    threshold: 60  # 60% of checks must pass
    action: "LOG - Record for improvement tracking"

# ---------------------------------------------------------------------------
# Testing Requirements: Tests that must run after code adaptation
# ---------------------------------------------------------------------------
testing_requirements:
  # Pre-modification: Run tests before making changes (baseline)
  pre_modification:
    - type: "unit_tests"
      command: "{{pre_test_command}}"  # e.g., "atest TelephonyTests"
      description: "Run existing unit tests to establish baseline"
      required: true

  # Post-modification: Run tests after making changes (verification)
  post_modification:
    - type: "unit_tests"
      command: "{{post_test_command}}"  # e.g., "atest TelephonyTests"
      description: "Verify existing tests still pass after modification"
      required: true
      baseline_comparison: true  # Must match or exceed pre-modification results

    - type: "build_check"
      command: "{{build_check_command}}"  # e.g., "m TeleService -j8"
      description: "Verify build succeeds with no new warnings"
      required: true

  # Regression tests specific to adaptation type
  regression:
    - type: "affected_area_tests"
      command: "{{regression_test_command}}"
      description: "Run tests for the specific area that was modified"
      required: false  # Recommended but not mandatory

# ---------------------------------------------------------------------------
# Safety Red Lines: Non-negotiable boundaries for code adaptation
# ---------------------------------------------------------------------------
safety_red_lines:
  - id: "no_functional_change"
    description: "Code adaptation must not change functional behavior"
    severity: "P0"
    check: "Code diff must show only style/formatting changes, no logic changes"

  - id: "no_test_removal"
    description: "Never remove or skip existing tests"
    severity: "P0"
    check: "Test file line count must not decrease"

  - id: "no_new_vulnerabilities"
    description: "Do not introduce security vulnerabilities (injection, XSS, etc.)"
    severity: "P0"
    check: "No patterns matching common vulnerability signatures in diff"

  - id: "no_api_surface_change"
    description: "Do not change public API signatures"
    severity: "P1"
    check: "Public method signatures unchanged in modified files"

  - id: "preserve_error_handling"
    description: "Do not remove or weaken existing error handling"
    severity: "P1"
    check: "No try/catch blocks, error returns, or error logs removed"

  - id: "no_hardcoded_values"
    description: "Do not introduce hardcoded configuration values"
    severity: "P2"
    check: "No magic numbers or hardcoded strings added"

# ---------------------------------------------------------------------------
# Evaluation Criteria: How code adaptation output is evaluated
# ---------------------------------------------------------------------------
evaluation_criteria:
  accuracy:
    - metric: "style_compliance"
      weight: 0.3
      description: "Modified code passes all applicable style checks"
      threshold: 0.9

    - metric: "compilation_success"
      weight: 0.3
      description: "Code compiles successfully after modification"
      threshold: 1.0

  completeness:
    - metric: "coverage"
      weight: 0.2
      description: "All files in scope received required adaptations"
      threshold: 0.85

    - metric: "tests_pass"
      weight: 0.2
      description: "All required tests pass after modification"
      threshold: 0.95

  safety:
    - metric: "red_line_compliance"
      weight: 1.0
      description: "Zero safety red line violations"
      threshold: 1.0

# ---------------------------------------------------------------------------
# Tool Access Configuration
# ---------------------------------------------------------------------------
tool_access:
  file_read: true
  file_write: true
  code_search: true
  log_parse: false
  git_ops: "full"  # read + write operations
  build_run: true
  report_gen: true
