# =============================================================================
# Carrier Porting Constraint Template
# =============================================================================
# Domain: carrier_porting (Adaptation Engine)
# Module: {{module_name}}
#
# This constraint file governs how the AI agent performs carrier-specific
# porting for the specified module. It defines carrier requirements,
# configuration rules, testing requirements, and certification compliance.
#
# Usage:
#   1. Copy to: constraints/<module_name>/carrier_porting.yaml
#   2. Replace all {{placeholder}} values
#   3. Customize configuration_rules for specific carrier requirements
#   4. Update certification_requirements based on target carrier
# =============================================================================

metadata:
  module: "{{module_name}}"
  domain: "carrier_porting"
  version: "1.0.0"
  author: "{{author}}"
  last_updated: "{{date}}"
  description: "Carrier porting constraints for {{module_name}} - porting for {{carrier_name}} ({{carrier_region}})"

# ---------------------------------------------------------------------------
# Carrier Information
# ---------------------------------------------------------------------------
carrier_info:
  # Target carrier details
  name: "{{carrier_name}}"            # e.g., "MTN", "Airtel", "Safaricom", "Vodafone"
  region: "{{carrier_region}}"        # e.g., "East Africa", "South Asia", "West Africa"
  country: "{{carrier_country}}"      # e.g., "Nigeria", "Kenya", "India", "Ghana"
  mcc_mnc: "{{carrier_mcc_mnc}}"      # e.g., "621.30" (MTN Nigeria)

  # Carrier requirements document reference
  requirements_doc: "{{carrier_requirements_doc}}"  # e.g., "docs/carriers/mtn-nigeria-reqs.pdf"

  # Platform baseline
  base_platform: "{{base_platform}}"  # e.g., "Android 14", "Android 15"
  device_family: "{{device_family}}"  # e.g., "TECNO Spark", "Infinix Note"

  # Porting type
  porting_type: "{{porting_type}}"    # Options: "new_carrier", "existing_carrier_update", "variant"

# ---------------------------------------------------------------------------
# Configuration Rules: Carrier-specific configurations
# ---------------------------------------------------------------------------
configuration_rules:
  # APN (Access Point Name) configuration
  apn_config:
    enabled: true
    file_path: "{{apn_config_path}}"  # e.g., "etc/apns-conf.xml"
    rules:
      - name: "{{apn_name_1}}"  # e.g., "MTN Internet"
        apn: "{{apn_value_1}}"  # e.g., "web.gprs.mtnnigeria.net"
        proxy: "{{apn_proxy_1}}"  # e.g., "10.199.212.2"
        port: "{{apn_port_1}}"  # e.g., "8080"
        user: "{{apn_user_1}}"  # e.g., ""
        password: "{{apn_password_1}}"  # e.g., ""
        server: "{{apn_server_1}}"
        mmsc: "{{apn_mmsc_1}}"
        mms_proxy: "{{apn_mms_proxy_1}}"
        auth_type: "{{apn_auth_type_1}}"  # e.g., "none", "pap", "chap"
        apn_type: "{{apn_type_1}}"  # e.g., "default,supl,mms"
        protocol: "{{apn_protocol_1}}"  # e.g., "IPV4V6"
        roaming_protocol: "{{apn_roaming_protocol_1}}"
        carrier_enabled: "true"
        editable: "{{apn_editable}}"  # e.g., "false" for locked APNs

    validation:
      - "APN type must include 'default' for internet connectivity"
      - "MMSC must be configured if MMS support is required"
      - "Duplicate APN entries are not allowed"

  # VoLTE (Voice over LTE) configuration
  volte_config:
    enabled: true
    rules:
      - item: "IMS_registration"
        parameter: "{{ims_reg_parameter}}"  # e.g., "volte.enabled"
        value: "{{ims_reg_value}}"  # e.g., "true"
        description: "Enable IMS registration for VoLTE"

      - item: "emergency_call"
        parameter: "{{emergency_call_parameter}}"  # e.g., "emergency.call.via.ims"
        value: "{{emergency_call_value}}"  # e.g., "true"
        description: "Enable VoLTE emergency calling"

      - item: "video_call"
        parameter: "{{video_call_parameter}}"  # e.g., "vt.enabled"
        value: "{{video_call_value}}"
        description: "Enable ViLTE (Video over LTE)"

      - item: "wifi_calling"
        parameter: "{{wifi_calling_parameter}}"  # e.g., "wfc.enabled"
        value: "{{wifi_calling_value}}"
        description: "Enable Wi-Fi Calling (VoWiFi)"

      - item: "sms_over_ip"
        parameter: "{{sms_over_ip_parameter}}"  # e.g., "sms_over_ip.enabled"
        value: "{{sms_over_ip_value}}"
        description: "Enable SMS over IP"

    validation:
      - "IMS stack must be initialized before VoLTE registration"
      - "Emergency call must work when IMS is not registered (CS fallback)"
      - "VoLTE must support cross-carrier interop if required by region"

  # SIM Toolkit (STK) configuration
  sim_toolkit_config:
    enabled: true
    rules:
      - item: "stk_menu_display"
        description: "Configure STK menu display format per carrier specs"
        parameter: "{{stk_menu_parameter}}"
        value: "{{stk_menu_value}}"

      - item: "stk_proactive_commands"
        description: "Enable carrier-specific STK proactive commands"
        supported_commands:
          - "DISPLAY_TEXT"
          - "GET_INPUT"
          - "SET_UP_MENU"
          - "{{additional_stk_command}}"  # e.g., "LAUNCH_BROWSER"

  # Carrier branding configuration
  branding_config:
    enabled: true
    rules:
      - item: "carrier_name_display"
        parameter: "{{carrier_display_parameter}}"  # e.g., "spn"
        value: "{{carrier_display_value}}"  # e.g., "MTN NG"
        description: "Network name shown in status bar"

      - item: "carrier_icon"
        path: "{{carrier_icon_path}}"  # e.g., "res/drawable/stat_sys_carrier.png"
        description: "Custom carrier icon in status bar"

      - item: "boot_animation"
        path: "{{boot_animation_path}}"  # e.g., "media/bootanimation.zip"
        description: "Custom boot animation with carrier branding"

  # Network selection configuration
  network_config:
    enabled: true
    rules:
      - item: "network_mode"
        parameter: "{{network_mode_parameter}}"  # e.g., "preferred_network_mode"
        value: "{{network_mode_value}}"  # e.g., "LTE/UMTS auto"
        description: "Default network mode selection"

      - item: "plmn_preference"
        parameter: "{{plmn_preference_parameter}}"
        value: "{{plmn_preference_value}}"  # e.g., "62130"
        description: "Preferred PLMN (MCC-MNC)"

      - item: "band_preference"
        parameter: "{{band_preference_parameter}}"
        value: "{{band_preference_value}}"  # e.g., "3,7,20,28"
        description: "Preferred LTE bands"

      - item: "volte_roaming"
        parameter: "{{volte_roaming_parameter}}"
        value: "{{volte_roaming_value}}"  # e.g., "true"
        description: "Enable VoLTE while roaming"

# ---------------------------------------------------------------------------
# Testing Requirements: Carrier-specific testing
# ---------------------------------------------------------------------------
testing_requirements:
  # Basic connectivity tests
  connectivity:
    - test: "voice_call"
      description: "Verify voice calls work (MO and MT)"
      required: true
      verification: "Call establishes, audio is bidirectional, call ends cleanly"

    - test: "video_call"
      description: "Verify video calls work if ViLTE is supported"
      required: false
      verification: "Video stream is established on both ends"

    - test: "sms"
      description: "Verify SMS send and receive"
      required: true
      verification: "SMS delivered within 30 seconds"

    - test: "mms"
      description: "Verify MMS send and receive"
      required: true
      verification: "MMS with attachment delivered within 60 seconds"

    - test: "data_connection"
      description: "Verify mobile data connectivity"
      required: true
      verification: "HTTP/HTTPS requests succeed on mobile data"

  # VoLTE-specific tests
  volte_tests:
    - test: "volte_registration"
      description: "Verify IMS registration and VoLTE availability"
      required: true
      verification: "IMS registered, VoLTE icon displayed"

    - test: "volte_call_srcc"
      description: "Verify Single Radio Voice Call Continuity (SRVCC)"
      required: false
      verification: "Call transitions from LTE to UMTS without drop"

    - test: "emergency_call"
      description: "Verify emergency calls work with VoLTE enabled"
      required: true
      verification: "Emergency call connects regardless of IMS status"

  # Roaming tests
  roaming_tests:
    - test: "international_roaming"
      description: "Verify service on international roaming"
      required: false
      verification: "Voice, SMS, and data work on roaming network"

    - test: "national_roaming"
      description: "Verify service on national roaming (partner network)"
      required: false
      verification: "Service handover to partner network is seamless"

  # STK tests
  stk_tests:
    - test: "stk_menu_navigation"
      description: "Verify STK menu displays correctly"
      required: false
      verification: "All STK menu items display and are navigable"

    - test: "stk_ussd"
      description: "Verify USSD session via STK"
      required: false
      verification: "USSD response received and displayed"

# ---------------------------------------------------------------------------
# Certification Requirements: Carrier and regulatory certifications
# ---------------------------------------------------------------------------
certification_requirements:
  # Carrier certification (required before commercial launch)
  carrier_certification:
    required: true
    certification_body: "{{certification_body}}"  # e.g., "MTN Technical Acceptance"
    test_plan_reference: "{{cert_test_plan}}"  # e.g., "docs/cert/mtn-test-plan-v2.pdf"
    checklist:
      - item: "Network registration"
        status: "pending"
      - item: "Voice call quality"
        status: "pending"
      - item: "SMS delivery reliability"
        status: "pending"
      - item: "Data throughput"
        status: "pending"
      - item: "VoLTE registration and call"
        status: "pending"
      - item: "Emergency call"
        status: "pending"
      - item: "SIM Toolkit"
        status: "pending"
      - item: "Carrier branding display"
        status: "pending"
      - item: "APN configuration"
        status: "pending"

  # Regulatory certification (country-specific)
  regulatory_certification:
    required: true
    standards:
      - "{{regulatory_standard_1}}"  # e.g., "NCC (Nigeria)"
      - "{{regulatory_standard_2}}"  # e.g., "SAR compliance"
    checklist:
      - item: "SAR compliance"
        status: "pending"
      - item: "Emergency number handling (112/911)"
        status: "pending"
      - item: "IMEI registration compliance"
        status: "pending"

# ---------------------------------------------------------------------------
# Safety Red Lines: Non-negotiable boundaries for carrier porting
# ---------------------------------------------------------------------------
safety_red_lines:
  - id: "no_emergency_call_impact"
    description: "Never modify configurations that could affect emergency call functionality"
    severity: "P0"
    check: "Emergency call must work with and without IMS, on all supported RATs"

  - id: "no_baseband_modification"
    description: "Do not modify baseband/modem firmware configurations without carrier approval"
    severity: "P0"
    check: "No changes to NV items, modem config, or baseband parameters"

  - id: "no_certified_config_override"
    description: "Do not override previously carrier-certified configurations without re-certification"
    severity: "P0"
    check: "Changes to certified configs must trigger re-certification workflow"

  - id: "no_cross_carrier_leak"
    description: "Carrier A configurations must not affect Carrier B configurations"
    severity: "P0"
    check: "Configuration changes are isolated to the target carrier's overlay"

  - id: "preserve_existing_functionality"
    description: "Carrier porting must not break existing carrier configurations"
    severity: "P1"
    check: "Existing carrier overlay configs remain unmodified"

  - id: "no_test_config_in_production"
    description: "Test/debug configurations must not be included in production builds"
    severity: "P1"
    check: "No test APNs, debug flags, or test SIM configurations in production"

  - id: "apn_auth_security"
    description: "APN authentication credentials must not be hardcoded in plaintext"
    severity: "P2"
    check: "Sensitive APN credentials stored securely if at all"

# ---------------------------------------------------------------------------
# Evaluation Criteria
# ---------------------------------------------------------------------------
evaluation_criteria:
  accuracy:
    - metric: "apn_configuration_correct"
      weight: 0.25
      description: "All APN entries match carrier specification"
      threshold: 1.0

    - metric: "volte_configuration_correct"
      weight: 0.2
      description: "VoLTE/IMS parameters match carrier requirements"
      threshold: 0.95

    - metric: "branding_correct"
      weight: 0.1
      description: "Carrier branding elements correctly applied"
      threshold: 0.9

  completeness:
    - metric: "config_coverage"
      weight: 0.2
      description: "All required configuration items are present"
      threshold: 0.95

    - metric: "certification_readiness"
      weight: 0.15
      description: "Configuration is ready for carrier certification testing"
      threshold: 0.8

    - metric: "test_execution"
      weight: 0.1
      description: "All required carrier tests have been executed"
      threshold: 0.9

  safety:
    - metric: "red_line_compliance"
      weight: 1.0
      description: "Zero safety red line violations"
      threshold: 1.0

# ---------------------------------------------------------------------------
# Tool Access Configuration
# ---------------------------------------------------------------------------
tool_access:
  file_read: true
  file_write: true
  code_search: true
  log_parse: true
  git_ops: "full"
  build_run: true
  report_gen: true
